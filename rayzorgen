        for q in s:
            print("  " + q["query"][:60] +
                  " | " + str(q["duration_ms"]) + " ms")
    except Exception as e:
        print("Error: " + str(e))


# ============================================================
# COMMANDS: CDC & TIMESERIES
# ============================================================

def cmd_cdc(db, args):
    try:
        cdc = db.cdc()
        events = cdc.recent(20)
        if not events:
            print("(belum ada event)")
            return
        for e in events:
            t = time.strftime(
                "%H:%M:%S", time.localtime(e["at"])
            )
            print("  " + t + " " + e["op"].ljust(8) +
                  e["collection"] + "/" +
                  e["record_id"][:8])
    except Exception as e:
        print("Error: " + str(e))


def cmd_ts_write(db, args):
    if len(args) < 2:
        print("Usage: ts-write <metric> <value>")
        return
    metric = args[0]
    try:
        value = float(args[1])
    except ValueError:
        print("Value harus angka.")
        return
    db.timeseries().write(metric, value)
    print("Ditulis: " + metric + " = " + str(value))


def cmd_ts_avg(db, args):
    if not args:
        print("Usage: ts-avg <metric> [last]")
        return
    metric = args[0]
    last = args[1] if len(args) > 1 else None
    try:
        v = db.timeseries().avg(metric, last=last)
        print("avg(" + metric + ") = " + str(v))
    except Exception as e:
        print("Error: " + str(e))


def cmd_ts_query(db, args):
    if not args:
        print("Usage: ts-query <metric> [last]")
        return
    metric = args[0]
    last = args[1] if len(args) > 1 else None
    try:
        points = db.timeseries().query(metric, last=last)
        if not points:
            print("(kosong)")
            return
        print(str(len(points)) + " points:")
        for ts, v in points[-20:]:
            t = time.strftime("%H:%M:%S", time.localtime(ts))
            print("  " + t + " " + str(v))
    except Exception as e:
        print("Error: " + str(e))


# ============================================================
# COMMANDS: SYSTEM
# ============================================================

def cmd_clear(db, args):
    cols = db.collections()
    if not cols:
        print("Sudah kosong.")
        return
    for c in cols:
        db.drop_collection(c)
    print(str(len(cols)) + " koleksi dihapus.")


