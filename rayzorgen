# Setup Wizard / Login
# ============================================================

def run_setup() -> bool:
    """First-time: create password."""
    clear()
    print_setup()

    for attempt in range(3):
        try:
            pw = getpass.getpass("  Buat password: ")
            confirm = getpass.getpass("  Ulangi password: ")
        except (EOFError, KeyboardInterrupt):
            print()
            return False

        if len(pw) < 4:
            print("  [!] Minimal 4 karakter.")
            continue
        if pw != confirm:
            print("  [!] Password tidak cocok.")
            continue

        if create_account(pw):
            print()
            print("  [OK] Password tersimpan.")
            print("       Jalankan lagi untuk login.")
            print()
            return False  # keluar setelah setup
        else:
            print("  [!] Gagal.")
            return False

    print("  [!] Terlalu banyak percobaan.")
    return False


def run_login() -> bool:
    """Existing account: ask password."""
    clear()
    print_login()

    for attempt in range(3):
        try:
            pw = getpass.getpass("  Password: ")
        except (EOFError, KeyboardInterrupt):
            print()
            return False

        if login(pw):
            print()
            print("  [OK] Login berhasil.")
            time.sleep(0.4)
            return True
        else:
            remaining = 2 - attempt
            print("  [!] Password salah." +
                (" Sisa: " + str(remaining) if remaining > 0 else ""))
            print()

    print("  [!] Terlalu banyak percobaan.")
    return False


# ============================================================
# Parsers
# ============================================================

def parse_data(s):
    s = s.strip()
    if s.startswith("{") or s.startswith("["):
        try:
            return json.loads(s)
        except json.JSONDecodeError:
            pass
    result = {}
    for part in s.split(","):
        if "=" in part:
            k, v = part.split("=", 1)
            result[k.strip()] = auto_cast(v.strip())
    return result if result else None


def auto_cast(v):
    if v.lower() in ("true", "false"):
        return v.lower() == "true"
    if v.lower() in ("null", "none", ""):
        return None
    try:
        return int(v)
    except ValueError:
        pass
    try:
        return float(v)
    except ValueError:
        pass
    return v


