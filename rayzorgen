def cmd_join(db, a):
    if len(a) < 4:
        print("  Usage: join <c1> <c2> <k1> <k2> [type]")
        return
    jt = a[4] if len(a) > 4 else "left"
    try:
        result = db.collection(a[0]).join(
            a[1], on=(a[2], a[3]), join_type=jt).all()
    except Exception as e:
        print("  Error: " + str(e))
        return
    if not result:
        print("  Kosong.")
        return
    for row in result:
        left = row["_joined"].get(a[0])
        right = row["_joined"].get(a[1], [])
        print("  " + str(left["data"] if isinstance(left, dict) else {}))
        for r in right:
            print("    -> " + str(r.get("data", {})))


