def _agg(db, a, op):
    if len(a) < 2:
        print("  Usage: " + op + " <col> <field>")
        return
    val = db.collection(a[0]).aggregate(a[1], op)
    print_table([{"koleksi": a[0], "field": a[1], op: val}],
                headers=["koleksi", "field", op])


