def cmd_filter(db, a):
    if len(a) < 4:
        print("  Usage: filter <col> <field> <op> <value>")
        return
    coll, field, op = a[0], a[1], a[2]
    value = auto_cast(" ".join(a[3:]))
    try:
        result = db.collection(coll).query().where(field, op, value).all()
    except Exception as e:
        print("  Error: " + str(e))
        return
    if not result:
        print("  Tidak ada hasil.")
        return
    rows = []
    for r in result:
        if isinstance(r, dict):
            row = {"id": r["id"][:8]}
            row.update(r["data"])
            rows.append(row)
        else:
            row = {"id": r.id[:8]}
            row.update(r.data)
            rows.append(row)
    print_table(rows)


def cmd_sort(db, a):
    if len(a) < 2:
        print("  Usage: sort <col> <field> [desc]")
        return
    desc = len(a) > 2 and a[2].lower() == "desc"
    result = db.collection(a[0]).query().order_by(a[1], desc=desc).all()
    rows = []
    for r in result:
        if isinstance(r, dict):
            row = {"id": r["id"][:8]}
            row.update(r["data"])
            rows.append(row)
        else:
            row = {"id": r.id[:8]}
            row.update(r.data)
            rows.append(row)
    print_table(rows)


