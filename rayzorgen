def cmd_filter(db, args):
    if len(args) < 4:
        print("Usage: filter <col> <field> <op> <value>")
        return
    coll, field, op = args[0], args[1], args[2]
    value = auto_cast(" ".join(args[3:]))
    if not db.has_collection(coll):
        print("Koleksi tidak ada.")
        return
    try:
        q = db.collection(coll).query().where(field, op, value)
        result = q.all()
    except ValueError as e:
        print("Error: " + str(e))
        return
    if not result:
        print("Tidak ada hasil.")
        return
    rows = []
    for r in result:
        if isinstance(r, dict):
            row = {"id": r["id"][:8]}
            row.update(r["data"])
            rows.append(row)
        else:
            row = {"id": r.id[:8]}
            row.update(r.data)
            rows.append(row)
    print(str(len(rows)) + " hasil:")
    print()
    print_table(rows)


