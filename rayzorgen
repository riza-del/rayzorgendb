def cmd_history(db, args):
    if len(args) < 2:
        print("Usage: history <col> <id>")
        return
    coll, rid = args[0], args[1]
    if not db.has_collection(coll):
        print("Koleksi tidak ada.")
        return
    h = db.collection(coll).history(rid)
    if not h:
        print("Tidak ada history.")
        return
    print(str(len(h)) + " versi:")
    print()
    for i, v in enumerate(h, 1):
        t = time.strftime(
            "%Y-%m-%d %H:%M:%S",
            time.localtime(v["at"])
        )
        print("  v" + str(v["version"]) + " | " + t +
              " | " + str(v["data"]))


def cmd_at(db, args):
    if len(args) < 2:
        print("Usage: at <col> <timestamp>")
        print("  Timestamp: unix (1699999999) atau 'YYYY-MM-DD'")
        return
    coll = args[0]
    ts = args[1]
    if not db.has_collection(coll):
        print("Koleksi tidak ada.")
        return
    try:
        if ts.replace(".", "").isdigit():
            ts_val = float(ts)
        else:
            t = time.strptime(ts, "%Y-%m-%d")
            ts_val = time.mktime(t)
    except Exception:
        print("Format waktu salah.")
        return
    snap = db.collection(coll).at(ts_val).all()
    if not snap:
        print("Tidak ada data di waktu itu.")
        return
    print(str(len(snap)) + " record di waktu " + ts + ":")
    print()
    for r in snap:
        print("  " + str(r))


