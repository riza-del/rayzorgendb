def cmd_insertmany(db, args):
    if len(args) < 2:
        print("Usage: insertmany <col> <json-array>")
        print('  Contoh: insertmany users [{"nama":"A"},{"nama":"B"}]')
        return
    coll = args[0]
    raw = " ".join(args[1:])
    try:
        items = json.loads(raw)
    except json.JSONDecodeError as e:
        print("JSON salah: " + str(e))
        return
    if not isinstance(items, list):
        print("Harus array.")
        return
    db.begin_batch()
    count = 0
    for item in items:
        db.collection(coll).insert(item)
        count += 1
    db.end_batch()
    print("Ditambah " + str(count) + " data ke '" + coll + "'.")


