def cmd_insert(db, a):
    if len(a) < 2:
        print("  Usage: insert <col> <data>")
        return
    data = parse_data(a[1])
    if not isinstance(data, dict):
        print("  Data harus dict.")
        return
    rec = db.collection(a[0]).insert(data)
    print("  Ditambah (id: " + rec.id[:8] + ")")


def cmd_insertmany(db, a):
    if len(a) < 2:
        print("  Usage: insertmany <col> <json-array>")
        return
    try:
        items = json.loads(a[1])
    except json.JSONDecodeError as e:
        print("  JSON salah: " + str(e))
        return
    if not isinstance(items, list):
        print("  Harus array.")
        return
    db.begin_batch()
    for item in items:
        db.collection(a[0]).insert(item)
    db.end_batch()
    print("  Ditambah " + str(len(items)) + " data.")


