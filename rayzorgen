        "sql": cmd_sql,
        "explain": cmd_explain,
        "analyze": cmd_analyze,
        "export": cmd_export,
        "import": cmd_import,
        "backup": cmd_backup,
        "snapshot": cmd_snapshot,
        "status": cmd_status,
        "stats": cmd_status,
        "metrics": cmd_metrics,
        "query-history": cmd_query_history,
        "slow": cmd_slow,
        "cdc": cmd_cdc,
        "ts-write": cmd_ts_write,
        "ts-avg": cmd_ts_avg,
        "ts-query": cmd_ts_query,
        "clear": cmd_clear,
        "changepw": cmd_changepw,
        "logout": cmd_logout,
        "help": lambda db, a: print_help(),
        "bantuan": lambda db, a: print_help(),
    }

    try:
        while True:
            try:
                line = input("rayzorgen> ").strip()
            except EOFError:
                break
            if not line:
                continue

            parts = line.split(" ", 1)
            cmd = parts[0].lower()
            rest = parts[1] if len(parts) > 1 else ""

            if cmd in ("exit", "quit", "keluar"):
                break

            if cmd in commands:
                if cmd in ("sql", "explain"):
                    args = [rest] if rest else []
                elif cmd in ("insert", "update", "import", "insertmany"):
                    sub = rest.split(" ", 1)
                    args = sub if rest else []
                else:
                    args = rest.split() if rest else []
                try:
                    commands[cmd](db, args)
                except SystemExit:
                    raise
                except Exception as e:
                    print("  Error: " + str(e))
            else:
                print("  Perintah tidak dikenal: '" + cmd + "'")
                print("  Ketik 'help' untuk bantuan.")
    finally:
        db.close()
        print_goodbye()


