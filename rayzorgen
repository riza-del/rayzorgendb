# ============================================================
# Table Printer
# ============================================================

def print_table(rows, headers=None, max_width=30):
    if not rows:
        print("  (kosong)")
        return
    if headers is None:
        headers = []
        seen = set()
        for r in rows:
            for k in r.keys():
                if k not in seen:
                    seen.add(k)
                    headers.append(k)

    def fmt(v):
        if v is None:
            return "-"
        if isinstance(v, bool):
            return "true" if v else "false"
        s = json.dumps(v, ensure_ascii=False) if isinstance(v, (list, dict)) else str(v)
        return s[:max_width - 3] + "..." if len(s) > max_width else s

    table = [[fmt(r.get(h, "")) for h in headers] for r in rows]
    widths = []
    for i, h in enumerate(headers):
        w = len(str(h))
        for row in table:
            w = max(w, len(row[i]))
        widths.append(w)

    def line():
        return "+" + "+".join("-" * (w + 2) for w in widths) + "+"

    def fmt_row(vals):
        return "| " + " | ".join(
            str(v).ljust(widths[i]) for i, v in enumerate(vals)
        ) + " |"

    print(line())
    print(fmt_row(headers))
    print(line())
    for row in table:
        print(fmt_row(row))
    print(line())


def records_to_rows(records):
    rows = []
    for r in records:
        if isinstance(r, dict):
            data = r.get("data", {})
            rid = r.get("id", "")
        else:
            data = r.data
            rid = r.id
        row = {"id": rid[:8]}
        row.update(data)
        rows.append(row)
    return rows


