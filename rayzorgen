def main():
    print()
    print("======================================================")
    print("       RayzorgenDB Shell - Extended")
    print("======================================================")
    print()
    print("Ketik 'help' untuk lihat semua perintah.")
    print("Ketik 'exit' untuk keluar.")
    print()

    db = RayzorgenDB()

    commands = {
        # Collections
        "create": cmd_create,
        "drop": cmd_drop,
        "collections": cmd_collections,
        # Data
        "insert": cmd_insert,
        "insertmany": cmd_insertmany,
        "show": cmd_show,
        "get": cmd_get,
        "update": cmd_update,
        "remove": cmd_remove,
        "delete": cmd_remove,
        "count": cmd_count,
        # Query
        "filter": cmd_filter,
        "sort": cmd_sort,
        "search": cmd_search,
        "avg": cmd_avg,
        "sum": cmd_sum,
        "min": cmd_min,
        "max": cmd_max,
        "group": cmd_group,
        "distinct": cmd_distinct,
        # Index
        "index": cmd_index,
        "sorted-index": cmd_sorted_index,
        "indexes": cmd_indexes,
        "drop-index": cmd_drop_index,
        "range": cmd_range,
        # Time Travel
        "history": cmd_history,
        "at": cmd_at,
        "diff": cmd_diff,
        "restore": cmd_restore,
        # Join
        "join": cmd_join,
        # SQL
        "sql": cmd_sql,
        "explain": cmd_explain,
        "analyze": cmd_analyze,
        # I/O
        "export": cmd_export,
        "import": cmd_import,
        "backup": cmd_backup,
        "snapshot": cmd_snapshot,
        # Monitor
        "status": cmd_status,
        "stats": cmd_stats,
        "metrics": cmd_metrics,
        "query-history": cmd_query_history,
        "slow": cmd_slow,
        # CDC & TS
        "cdc": cmd_cdc,
        "ts-write": cmd_ts_write,
        "ts-avg": cmd_ts_avg,
        "ts-query": cmd_ts_query,
        # System
        "clear": cmd_clear,
        "help": lambda db, a: print_help(),
        "bantuan": lambda db, a: print_help(),
    }

    try:
        while True:
            try:
                line = input("rayzorgen> ").strip()
            except EOFError:
                break

            if not line:
                continue

            # Split by first space, sisanya utuh
            if " " in line:
                cmd, rest = line.split(" ", 1)
                args = rest.split()
                # Reassemble untuk argumen panjang (SQL, JSON)
                if cmd in ("sql", "explain"):
                    args = [rest]
                elif cmd == "insertmany":
                    args = rest.split(" ", 1)
                elif cmd in ("insert", "update", "import"):
                    args = rest.split(" ", 1)
            else:
                cmd = line
                args = []

            cmd = cmd.lower()

            if cmd in ("exit", "quit", "keluar"):
                print("Sampai jumpa.")
                break

            if cmd in commands:
                try:
                    # Konversi string tunggal ke list
                    if isinstance(args, str):
                        args = [args]
                    commands[cmd](db, args)
                except Exception as e:
                    print("Error: " + str(e))
            else:
                print("Perintah tidak dikenal: '" + cmd + "'")
                print("Ketik 'help' untuk bantuan.")
    finally:
        db.close()
        print("Data tersimpan.")


if __name__ == "__main__":
    main()
