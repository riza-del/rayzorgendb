def cmd_join(db, args):
    if len(args) < 4:
        print("Usage: join <col1> <col2> <key1> <key2> [inner|left|right]")
        return
    c1, c2, k1, k2 = args[0], args[1], args[2], args[3]
    jt = args[4] if len(args) > 4 else "left"
    if not db.has_collection(c1) or not db.has_collection(c2):
        print("Salah satu koleksi tidak ada.")
        return
    try:
        result = db.collection(c1).join(
            c2, on=(k1, k2), join_type=jt
        ).all()
    except Exception as e:
        print("Error: " + str(e))
        return
    if not result:
        print("Tidak ada hasil.")
        return
    print(str(len(result)) + " baris hasil JOIN (" + jt + "):")
    print()
    for row in result:
        left = row["_joined"].get(c1)
        right = row["_joined"].get(c2, [])
        ldata = left["data"] if isinstance(left, dict) else {}
        print("  " + str(ldata))
        if isinstance(right, list):
            for r in right:
                print("    → " + str(r.get("data", {})))


